# Copy to .env for local development. Real environment variables override .env.
# Never put real secrets in this file.

# Display name (final name undecided; change it only here)
APP_NAME=TrendTrace

# dev | prod.  prod + DATA_MODE=mock is refused at startup.
APP_ENV=dev
# mock | real.  real needs Adrian's loader (backend/app/services/real_store.py) + Group 3's files in
# data/processed/. Without the loader: dev serves DATA_NOT_AVAILABLE everywhere, prod refuses to start.
DATA_MODE=mock
# Mock only: normal | sparse (~40% missing) | short (< 10 years)
MOCK_SCENARIO=normal

# Optional pin: if set, startup fails unless the loaded data has this data_version.
DATA_VERSION=
CONTRACT_VERSION=1.0

# Uvicorn does not read PORT by itself; pass --port $PORT (see README).
PORT=8000
LOG_LEVEL=INFO
# One explicit origin (no wildcard). Vite dev server default:
ALLOWED_ORIGIN=http://localhost:5173

# Paths are relative to the repository root.
REPORTS_DIR=reports
MOCK_DIR=data/mock
PROCESSED_DIR=data/processed

# Largest accepted request body in bytes.
MAX_BODY_BYTES=65536

# AI explanations (Adrian). Empty = template explanations only. Read by config.py
# Empty provider/model/key keeps automatic summaries available.
# LLM_PROVIDER: groq (recommended, free tier) | gemini (free tier) | openai (paid)
# Example: LLM_PROVIDER=groq  LLM_MODEL=openai/gpt-oss-120b  (key from console.groq.com)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
